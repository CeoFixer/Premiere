# Copy to .env (never commit it). Only SITE_URL, STRIPE_SECRET_KEY and
# ACCESS_TOKEN_SECRET are required to sell the film; the rest turn on extras.

# Public address of the site (used in Stripe redirects and e-mailed links).
# REQUIRED on a real server: without it the API refuses to build links
# (only http://localhost works for local testing).
SITE_URL=https://www.fixer-premiere.com

# Stripe — Dashboard → Developers → API keys. Use a restricted key if you like:
# needs write access to Checkout Sessions and PaymentIntents (the webhook saves the
# lower-cased buyer e-mail on it) and read access to Charges and Disputes.
STRIPE_SECRET_KEY=sk_live_xxx
# Stripe — Dashboard → Developers → Webhooks → endpoint https://<site>/api/stripe-webhook
# events: checkout.session.completed, checkout.session.async_payment_succeeded
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Film price in cents (700 = $7). Read at build time (price shown on the pages)
# and at run time (price charged) — set it in both places / rebuild after changing.
FILM_PRICE_CENTS=700
# Optional: charge an existing Stripe Price instead of the inline price above
STRIPE_FILM_PRICE_ID=

# Random secret for signing watch links, 32+ characters:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every link already sent.
ACCESS_TOKEN_SECRET=

# The full film — option 1: private S3-compatible bucket (AWS S3, Cloudflare R2, ...)
FILM_S3_BUCKET=
FILM_S3_KEY=la-plage/la-plage-1080p.mp4
FILM_S3_REGION=us-east-1
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
FILM_S3_ENDPOINT=
FILM_S3_ACCESS_KEY_ID=
FILM_S3_SECRET_ACCESS_KEY=
# The full film — option 2: private/unlisted player link (Vimeo, Bunny Stream, ...).
# Weaker than option 1: every buyer sees the same player URL, so restrict it to
# your domain in the video provider's settings (Vimeo "embed only on", Bunny token auth).
FILM_EMBED_URL=

# E-mail (watch links, form notifications). Titan example:
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=app@fixer-app.com
SMTP_PASS=
MAIL_FROM=Fixer Premiere <app@fixer-app.com>
# Where form submissions go (default support@fixer-app.com)
NOTIFY_EMAIL=
# Optional: also POST form submissions as JSON here (Zapier, Make, Google Apps Script)
FORMS_WEBHOOK_URL=

# Buyers from the old Wix site keep access (comma-separated e-mails)
LEGACY_BUYER_EMAILS=
# Block a leaked link: checkout session ids (cs_live_...) and/or e-mails, comma-separated
REVOKED_ACCESS=

# Trailer: mp4 URL or YouTube/Vimeo embed URL (default: the Wix-hosted trailer)
TRAILER_URL=

# Standalone server only. With TRUST_PROXY=1 (behind nginx/Caddy) the server
# listens on 127.0.0.1 only, so client IPs can't be spoofed via X-Forwarded-For.
# On Render/Railway/Fly set HOST=0.0.0.0 (their proxy doesn't use loopback).
PORT=3000
TRUST_PROXY=1
# HOST=127.0.0.1
